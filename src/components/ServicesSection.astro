---
const tracks = [
  {
    name: 'Platform, AWS and SRE',
    description: 'Landing zones, cost and security reviews, migrations, pipelines, on-call that stays quiet.',
    link: '/services/#platform',
    trackName: 'Platform',
    icon: 'M2 20h20M4 20V8l8-5 8 5v12M9 20v-6h6v6',
  },
  {
    name: 'AI adoption',
    description: 'Picking the use case, proving it on your data, running it in production.',
    link: '/services/#ai-adoption',
    trackName: 'AI adoption',
    icon: 'M12 2a4 4 0 014 4v1h1a3 3 0 013 3v2a3 3 0 01-3 3h-1v1a4 4 0 01-8 0v-1H7a3 3 0 01-3-3v-2a3 3 0 013-3h1V6a4 4 0 014-4zM9 11h.01M15 11h.01M10 15h4',
  },
  {
    name: 'Software engineering',
    description: 'Backend and platform code in TypeScript and Python, shipped into your repo.',
    link: '/services/#software',
    trackName: 'Software',
    icon: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
  },
];
---

<section id="services" class="section relative overflow-hidden bg-white">
  <div class="band-grid" aria-hidden="true"></div>
  <div class="container-site relative">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-4">Services</p>
      <h2 class="text-h2">What we do</h2>
      <p class="mt-4 text-lg text-slate-600">
        Three kinds of work. Scope, team and dates agreed in writing before anything starts.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3" data-reveal>
      {tracks.map((track) => (
        <article class="card card-hover flex flex-col">
          <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-accent-tint">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={track.icon} />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-slate-900">{track.name}</h3>
          <p class="mt-3 leading-relaxed text-slate-600">{track.description}</p>
          <div class="mt-auto pt-7">
            <a href={track.link} class="font-semibold text-accent no-underline transition-colors duration-fast hover:text-accent-hover" data-track-service={track.trackName}>
              Learn more →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
