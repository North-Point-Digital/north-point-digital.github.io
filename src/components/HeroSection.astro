---
const CALENDLY = 'https://calendly.com/david-northpointdigital/north-point-digital-initial-call';
---

<section id="home" class="relative overflow-hidden bg-white pt-16">
  <div class="hero-tint h-[560px]" aria-hidden="true"></div>
  <div class="hero-dots" aria-hidden="true"></div>

  <div class="container-site relative py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-6">AWS · AI · Software engineering</p>

      <h1 class="text-h1">
        Platform, AI and <span class="text-accent">software engineering.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl">
        Senior engineers who work inside your team, scoped in writing before they start.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={CALENDLY}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          data-track-cta="Hero Book a Call"
        >
          Book a call
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a
          href="/#case-studies"
          class="font-semibold text-slate-700 no-underline transition-colors duration-fast hover:text-slate-900"
          data-track-cta="Hero Case Studies"
        >
          See the case studies →
        </a>
      </div>

      <div class="mt-12 flex items-center justify-center gap-2.5 text-sm text-slate-500">
        <img src="/aws-logo.png" alt="Amazon Web Services" width="34" height="20" class="h-5 w-auto" loading="eager" />
        Official AWS Partner
      </div>
    </div>
  </div>
</section>
